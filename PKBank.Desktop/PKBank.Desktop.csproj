<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>PKBank.Desktop</RootNamespace>
        <AssemblyName>PKBank.Desktop</AssemblyName>
        <Description>Pokémon Save Editor (cross-platform UI)</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1"/>
        <PackageReference Include="QRCoder" Version="1.7.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\packages\PKHeX\PKHeX.Core\PKHeX.Core.csproj"/>
        <ProjectReference Include="..\PKBank.Core\PKBank.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\packages\PKHeX\PKHeX.Drawing.PokeSprite\Util\SpriteName.cs" Link="Sprites\SpriteName.cs"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\packages\PKHeX\PKHeX.Drawing.PokeSprite\Resources\img\Big Pokemon Sprites\*.png" LogicalName="pkm.%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\packages\PKHeX\PKHeX.Drawing.PokeSprite\Resources\img\Big Shiny Sprites\*.png" LogicalName="pkm.%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\packages\PKHeX\PKHeX.Drawing.PokeSprite\Resources\img\Big Items\*.png" LogicalName="item.%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\packages\PKHeX\PKHeX.Drawing.PokeSprite\Resources\img\ball\*.png" LogicalName="ball.%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\packages\PKHeX\PKHeX.Drawing.PokeSprite\Resources\img\valid.png" LogicalName="misc.valid.png"/>
        <EmbeddedResource Include="..\packages\PKHeX\PKHeX.Drawing.PokeSprite\Resources\img\warn.png" LogicalName="misc.warn.png"/>
        <EmbeddedResource Include="..\packages\PKHeX\PKHeX.Drawing.Misc\Resources\img\types\square_s\*.png" LogicalName="type.%(Filename)%(Extension)"/>
        <AvaloniaResource Include="..\packages\PKHeX\icon.png" Link="Assets\icon.png"/>
    </ItemGroup>

</Project>
