<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components"
             x:Class="PKBank.Desktop.Components.MainWindowMenu"
             x:DataType="vm:MainWindowViewModel">

    <Menu x:Name="RootMenu">
        <MenuItem Header="_File">
            <MenuItem
                Header="_Open…"
                Click="OnOpenClicked"
                InputGesture="Ctrl+O" />
            <MenuItem
                Header="_Close"
                Click="OnCloseClicked"
                IsEnabled="{Binding HasSave}"
                InputGesture="Ctrl+W" />
            <MenuItem
                Header="_Save"
                Click="OnSaveClicked"
                IsEnabled="{Binding CanSave}"
                InputGesture="Ctrl+S" />
            <MenuItem
                Header="Save _As…"
                Click="OnSaveAsClicked"
                IsEnabled="{Binding HasSave}"
                InputGesture="Ctrl+Shift+S" />
            <MenuItem
                Header="E_xit"
                Click="OnExitClicked" />
        </MenuItem>
        <MenuItem Header="_Edit">
            <MenuItem
                Header="_Trainer…"
                Click="OnTrainerClicked"
                IsEnabled="{Binding CanEditTrainer}" />
            <MenuItem
                Header="_Pokédex…"
                Click="OnPokedexClicked"
                IsEnabled="{Binding CanEditPokedex}" />
            <MenuItem
                Header="_Inventory…"
                Click="OnInventoryClicked"
                IsEnabled="{Binding CanEditInventory}" />
            <MenuItem
                Header="_Roamer…"
                Click="OnRoamerClicked"
                IsEnabled="{Binding CanEditRoamer}" />
            <Separator />
            <MenuItem
                Header="_Mystery Gift…"
                Click="OnMysteryGiftClicked"
                IsEnabled="{Binding CanEditMysteryGift}" />
            <MenuItem
                Header="_Gen 3 Events"
                IsEnabled="{Binding IsGen3Save}">
                <MenuItem
                    Header="Mystery Gift (WC3)…"
                    Click="OnWC3Clicked"
                    IsEnabled="{Binding IsGen3FRLGE}" />
                <MenuItem
                    Header="Mystery Event (ME3)…"
                    Click="OnME3Clicked"
                    IsEnabled="{Binding IsGen3RSE}" />
                <MenuItem
                    Header="e-Card Trainer (ECT)…"
                    Click="OnECTClicked" />
                <MenuItem
                    Header="e-Card Berry (ECB)…"
                    Click="OnECBClicked" />
                <MenuItem
                    Header="Wonder News (WN3)…"
                    Click="OnWN3Clicked"
                    IsEnabled="{Binding IsGen3FRLGE}" />
                <Separator />
                <MenuItem
                    Header="Record Mixing…"
                    Click="OnRecordMixingClicked"
                    IsEnabled="{Binding IsGen3RSE}" />
            </MenuItem>
        </MenuItem>
        <MenuItem Header="_Options">
            <MenuItem x:Name="LanguageMenu" Header="_Language" />
            <Separator />
            <MenuItem
                Header="_Settings…"
                Click="OnSettingsClicked" />
            <MenuItem
                x:Name="AboutMenuItem"
                Click="OnAboutClicked" />
        </MenuItem>
    </Menu>

</UserControl>
