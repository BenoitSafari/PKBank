<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKBank.Desktop.Components.Legality.LegalityReportWindow"
        Title="Legality Report"
        Width="480" MaxHeight="640" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="{DynamicResource SpacingLarge}">

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingRegular}">
      <Image x:Name="SpriteImage" Width="68" Height="56" Stretch="None"/>
      <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource SpacingExtraSmall}">
        <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontSizeExtraLarge}" FontWeight="SemiBold"/>
        <TextBlock x:Name="VerdictText" FontWeight="SemiBold"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer MaxHeight="480">
      <SelectableTextBlock x:Name="ReportText" TextWrapping="Wrap" FontFamily="monospace" FontSize="{DynamicResource FontSizeRegular}" Margin="0,0,8,0"/>
    </ScrollViewer>

    <Button Content="Close" HorizontalAlignment="Right" Click="OnCloseClicked"/>

  </StackPanel>

</Window>
