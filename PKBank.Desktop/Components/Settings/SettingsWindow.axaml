<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:directoryPathList="clr-namespace:PKBank.Desktop.Components.Common.DirectoryPathList"
    x:Class="PKBank.Desktop.Components.Settings.SettingsWindow"
    Title="Settings"
    Width="560" Height="520"
    MinWidth="420" MinHeight="460"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16" RowSpacing="{DynamicResource SpacingLarge}" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" Text="Program" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeLarge}" />
        <Grid Grid.Row="1" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto" Margin="4,0,0,0">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Game data language"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="1"
                x:Name="LanguageCombo"
                HorizontalAlignment="Stretch" Margin="0,3"
                SelectionChanged="OnLanguageChanged" />
        </Grid>

        <TextBlock Grid.Row="2" Text="Folders" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeLarge}" />
        <directoryPathList:DirectoryPathList
            Grid.Row="3"
            x:Name="SavFolders"
            Header="Save Folders"
            ColumnHeader="Save Directory"
            PickerTitle="Add Save Folder"
            PathAdded="OnSavPathAdded"
            PathRemoved="OnSavPathRemoved" />

        <!-- One folder holding every bank, one sub-folder each -->
        <StackPanel Grid.Row="4" Spacing="{DynamicResource SpacingExtraSmall}">
            <TextBlock Text="Banks Folder" Margin="4,0,0,0" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource SpacingSmall}">
                <TextBox Grid.Column="0" x:Name="BanksPathBox"
                         KeyDown="OnBanksPathKeyDown" LostFocus="OnBanksPathLostFocus" />
                <Button Grid.Column="1" Content="Browse…" MinWidth="86" Click="OnBanksBrowseClicked" />
                <Button Grid.Column="2" Content="Default" MinWidth="86" Click="OnBanksDefaultClicked"
                        ToolTip.Tip="Use the default banks folder, next to the settings file" />
            </Grid>
            <TextBlock x:Name="BanksPathNote" Margin="4,0,0,0" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeRegular}"
                       Foreground="{DynamicResource SystemErrorTextColor}" IsVisible="False" />
        </StackPanel>

        <Button Grid.Row="5" Content="Close" HorizontalAlignment="Right" Click="OnCloseClicked" />
    </Grid>
</Window>
