<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:directoryPathList="clr-namespace:PKBank.Desktop.Components.Common.DirectoryPathList"
    x:Class="PKBank.Desktop.Components.Settings.SettingsWindow"
    Title="Settings"
    Width="560" Height="620"
    MinWidth="420" MinHeight="460"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16" RowSpacing="14" RowDefinitions="Auto,Auto,Auto,*,*,Auto">
        <TextBlock Grid.Row="0" Text="Program" FontWeight="SemiBold" FontSize="15" />
        <Grid Grid.Row="1" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto" Margin="4,0,0,0">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Game data language"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="1"
                x:Name="LanguageCombo"
                HorizontalAlignment="Stretch" Margin="0,3"
                SelectionChanged="OnLanguageChanged" />
        </Grid>

        <TextBlock Grid.Row="2" Text="Folders" FontWeight="SemiBold" FontSize="15" />
        <directoryPathList:DirectoryPathList
            Grid.Row="3"
            x:Name="SavFolders"
            Header="Save Folders"
            ColumnHeader="Save Directory"
            PickerTitle="Add Save Folder"
            PathAdded="OnSavPathAdded"
            PathRemoved="OnSavPathRemoved" />
        <directoryPathList:DirectoryPathList
            Grid.Row="4"
            x:Name="BankFolders"
            Header="Bank Folders (will be scanned for Pokémon files)"
            ColumnHeader="Bank Directory"
            PickerTitle="Add Bank Folder"
            PathAdded="OnBankPathAdded"
            PathRemoved="OnBankPathRemoved" />

        <Button Grid.Row="5" Content="Close" HorizontalAlignment="Right" Click="OnCloseClicked" />
    </Grid>
</Window>
