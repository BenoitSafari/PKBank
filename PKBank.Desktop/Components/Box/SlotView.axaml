<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components.Box.ViewModels"
             x:Class="PKBank.Desktop.Components.Box.SlotView"
             x:DataType="vm:SlotViewModel">

    <Button Classes="slot" Classes.selected="{Binding IsSelected}" Classes.occupied="{Binding !IsEmpty}"
            Click="OnClicked" ToolTip.Tip="{Binding Preview}">
        <Button.ContextMenu>
            <ContextMenu Opening="OnMenuOpening">
                <!-- Header flips to "New" on an empty slot; see OnMenuOpening -->
                <MenuItem Header="Edit" Tag="edit" Click="OnEditClicked" />
                <Separator />
                <MenuItem Header="Copy" Tag="copy" Click="OnCopyClicked" />
                <MenuItem Header="Paste" Tag="paste" Click="OnPasteClicked" />
                <Separator />
                <MenuItem Header="Import…" Tag="import" Click="OnImportClicked" />
                <MenuItem Header="Export…" Tag="export" Click="OnExportClicked" />
                <Separator />
                <MenuItem Header="To Bank" Tag="tobank" Click="OnToBankClicked" />
                <MenuItem Header="To Save" Tag="tosave" Click="OnToSaveClicked" />
                <Separator />
                <MenuItem Header="Delete" Tag="delete" Click="OnDeleteClicked" />
            </ContextMenu>
        </Button.ContextMenu>
        <Image Source="{Binding Sprite}" Width="68" Height="56" Stretch="None" />
    </Button>

</UserControl>
