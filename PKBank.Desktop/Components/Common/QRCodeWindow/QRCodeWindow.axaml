<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKBank.Desktop.Components.Common.QRCodeWindow.QRCodeWindow"
        Title="PKHeX QR Code"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>

        <Border Background="White" Padding="12">
            <Panel>
                <Image x:Name="QrImage" Width="384" Height="384"
                       RenderOptions.BitmapInterpolationMode="None" />
                <Border Background="White" Padding="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel>
                        <Image x:Name="SpriteImage" Width="68" Height="56" Stretch="None" />
                        <Image x:Name="LegalityImage" Width="9" Height="9" Stretch="None"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Panel>
                </Border>
            </Panel>
        </Border>

        <StackPanel Margin="14,10" Spacing="2">
            <ItemsControl x:Name="LinesControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeRegular}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </StackPanel>

</Window>
