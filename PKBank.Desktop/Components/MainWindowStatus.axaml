<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components"
             x:Class="PKBank.Desktop.Components.MainWindowStatus"
             x:DataType="vm:MainWindowViewModel">

    <Border
        Padding="{DynamicResource BaseInputPadding}"
        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Right"
                Text="{Binding TrainerInfo}"
                FontSize="{DynamicResource FontSizeRegular}"
                FontWeight="Light"
                Opacity="0.8" />
            <TextBlock
                Text="{Binding StatusMessage}"
                FontSize="{DynamicResource FontSizeRegular}"
                FontWeight="Light"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Border>

</UserControl>
