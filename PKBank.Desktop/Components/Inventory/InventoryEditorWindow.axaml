<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKBank.Desktop.Components.Inventory.ViewModels"
        xmlns:core="using:PKHeX.Core"
        x:Class="PKBank.Desktop.Components.Inventory.InventoryEditorWindow"
        Title="Inventory Editor"
        Width="480" Height="680"
        MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="ItemChoiceTemplate" DataType="core:ComboItem">
            <TextBlock Text="{Binding Text}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto" Margin="14">

        <TabControl x:Name="PouchTabs" Grid.Row="0">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="vm:InventoryPouchViewModel">
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="vm:InventoryPouchViewModel">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,120" Margin="10,8,26,4">
                                <TextBlock Grid.Column="0" Text="Item" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}"/>
                                <TextBlock Grid.Column="1" Text="Count" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" HorizontalAlignment="Center"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Rows}">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="10,1"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:InventoryItemViewModel">
                                        <Grid ColumnDefinitions="*,120">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,2,8,2"
                                                      ItemsSource="{Binding $parent[ListBox].((vm:InventoryPouchViewModel)DataContext).ItemChoices}"
                                                      ItemTemplate="{StaticResource ItemChoiceTemplate}"
                                                      SelectedValueBinding="{ReflectionBinding Value}"
                                                      SelectedValue="{Binding ItemId, Mode=TwoWay}"/>
                                            <NumericUpDown Grid.Column="1" Minimum="0" Increment="1" Margin="0,2"
                                                           Maximum="{Binding $parent[ListBox].((vm:InventoryPouchViewModel)DataContext).MaxCount}"
                                                           Value="{Binding Count, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="Sort" MinWidth="96" Click="OnSortClicked"
                    ToolTip.Tip="Sort this pouch by item name"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource SpacingRegular}">
                <Button Content="Cancel" MinWidth="96" Click="OnCancelClicked"/>
                <Button Content="Save" MinWidth="96" Click="OnSaveClicked"/>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
