<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKBank.Desktop.Components.Events.MysteryGiftEditorWindow"
        Title="Mystery Gift Editor"
        Width="780" Height="600"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="14">
        <Grid Grid.Row="0" ColumnDefinitions="*,300">
            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,10,0">
                <ScrollViewer>
                    <StackPanel x:Name="AlbumPanel" Spacing="{DynamicResource SpacingSmall}" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border
                    Grid.Row="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                    <StackPanel Spacing="{DynamicResource SpacingRegular}">
                        <Image
                            x:Name="PreviewImage"
                            Width="68"
                            Height="56"
                            Stretch="None"
                            HorizontalAlignment="Center" />
                        <CheckBox
                            x:Name="UsedCheck"
                            Content="Gift used"
                            HorizontalAlignment="Center"
                            IsCheckedChanged="OnUsedChanged" />
                        <ItemsControl x:Name="DescriptionLines" MinHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeRegular}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="ErrorText"
                            Foreground="#C42B1C"
                            TextWrapping="Wrap"
                            FontSize="{DynamicResource FontSizeRegular}"
                            IsVisible="False" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="Received Flags" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="ReceivedList" Grid.Row="1" SelectionMode="Multiple" />
                        <Button
                            Grid.Row="2"
                            Content="Remove Selected"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0"
                            Click="OnRemoveFlagsClicked" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource SpacingRegular}">
                <Button Content="Import…" MinWidth="90" Click="OnImportClicked" />
                <Button Content="Export…" MinWidth="90" Click="OnExportClicked" />
                <Button x:Name="QrButton" Content="QR" MinWidth="60" Click="OnQrClicked" />
                <Button x:Name="UsedAllButton" Content="Used All" MinWidth="90" Click="OnUsedAllClicked" />
                <Button x:Name="UnusedAllButton" Content="Unused All" MinWidth="90" Click="OnUnusedAllClicked" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource SpacingRegular}">
                <Button Content="Cancel" MinWidth="96" Click="OnCancelClicked" />
                <Button Content="Save" MinWidth="96" Click="OnSaveClicked" />
            </StackPanel>
        </Grid>

    </Grid>

</Window>
