<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components"
             xmlns:ss="using:PKBank.Desktop.Components.SaveSelection"
             xmlns:ssVm="using:PKBank.Desktop.Components.SaveSelection.ViewModels"
             x:Class="PKBank.Desktop.Components.SaveSelection.SaveSelectionView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Actions are always available, even while the list is empty or loading -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="Open…" MinWidth="96" Click="OnOpenClicked" />
            <Button Content="Load" MinWidth="96" Classes="accent"
                    IsEnabled="{Binding SaveSelection.CanLoadSelected}"
                    Click="OnLoadClicked" />
        </StackPanel>

        <Panel>

            <!-- Scanning the configured folders -->
            <StackPanel IsVisible="{Binding SaveSelection.IsScanning}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock Text="Looking for save files…" HorizontalAlignment="Center" Opacity="0.8" />
            </StackPanel>

            <!-- Nothing found: point the user at the folder configuration -->
            <StackPanel IsVisible="{Binding SaveSelection.IsEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="420">
                <TextBlock Text="No save file detected" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock
                    Text="None of the configured folders contain a recognized save file."
                    TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" />
                <Button Content="Edit Access Paths" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Click="OnEditPathsClicked" />
            </StackPanel>

            <!-- The list owns its scrollbar; the action bar below stays put -->
            <Border IsVisible="{Binding SaveSelection.HasSaves}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <ListBox x:Name="SavesList"
                         ItemsSource="{Binding SaveSelection.Saves}"
                         SelectedItem="{Binding SaveSelection.SelectedSave, Mode=TwoWay}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         DoubleTapped="OnRowDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="ssVm:SaveEntryViewModel">
                            <!-- Row 0 is pinned to the sprite height; row 1 only exists when the
                                 game block wraps under the identity line. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="32,Auto"
                                  ColumnSpacing="12" ToolTip.Tip="{Binding Tooltip}">

                                <!-- Every avatar reaches this point already at 32px (SpriteService
                                     downsamples PKHeX's 40px Gen 6 art), so it draws 1:1. -->
                                <Panel Grid.Row="0" Grid.Column="0" Width="32" Height="32" ClipToBounds="True">
                                    <Image Source="{Binding Sprite}" Stretch="None"
                                           RenderOptions.BitmapInterpolationMode="None"
                                           IsVisible="{Binding HasSprite}" />
                                    <!-- No avatar for this save format: neutral stand-in -->
                                    <Border IsVisible="{Binding !HasSprite}"
                                            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            BorderThickness="1" CornerRadius="16">
                                        <Viewbox Margin="7">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="7.5" Canvas.Top="3" Width="9" Height="9"
                                                         Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <Path
                                                    Data="M3,22 C3,17 7,14 12,14 C17,14 21,17 21,22 Z"
                                                    Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Panel>

                                <!-- Identity over path; the two sub-rows add up to the 32px row height -->
                                <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="19,13">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TrainerName}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="·" Opacity="0.5" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TrainerId}" FontSize="12" Opacity="0.8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="·" Opacity="0.5" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasGender}" />
                                        <TextBlock Text="{Binding Gender}" FontSize="12" Opacity="0.8"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding HasGender}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Path}" FontSize="10" Opacity="0.55"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- Wide enough: game and play time close the same line -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                            IsVisible="{Binding !$parent[ss:SaveSelectionView].IsNarrow}">
                                    <TextBlock Text="{Binding GameName}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="·" Opacity="0.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PlayTime}" FontSize="12" Opacity="0.8"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Too narrow: they drop under the identity line instead of being trimmed -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                                            IsVisible="{Binding $parent[ss:SaveSelectionView].IsNarrow}">
                                    <TextBlock Text="{Binding GameName}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="·" Opacity="0.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PlayTime}" FontSize="12" Opacity="0.8"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

        </Panel>

    </DockPanel>

</UserControl>
