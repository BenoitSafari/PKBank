<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKBank.Desktop.Components.Roamer.Roamer3EditorWindow"
        Title="Roamer Editor"
        Width="430" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="14" Spacing="{DynamicResource SpacingLarge}">

        <Border
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
            <StackPanel Spacing="{DynamicResource SpacingSmall}">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0,0,6">
                    <TextBlock Text="Roamer" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="VerdictText"
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                    <Button
                        x:Name="FixButton"
                        Grid.Column="2"
                        Content="Fix"
                        MinWidth="42"
                        Padding="8,2"
                        IsVisible="False"
                        Click="OnFixClicked"
                        ToolTip.Tip="Rebuild a PID/IV pair the game could have rolled" />
                </Grid>
                <TextBlock
                    x:Name="DetailText"
                    TextWrapping="Wrap"
                    Opacity="0.8"
                    Margin="2,0,0,2"
                    IsVisible="False"
                    FontSize="{DynamicResource FontSizeRegular}" />

                <!-- Species and level are the game's call: shown, never edited. -->
                <Grid ColumnDefinitions="110,*,110,*">
                    <TextBlock Classes="fieldLabel" Text="Species" />
                    <TextBlock
                        x:Name="SpeciesText"
                        Grid.Column="1"
                        Classes="fieldValue"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Level" />
                    <TextBlock x:Name="LevelText" Grid.Column="3" Classes="fieldValue" />
                </Grid>

                <Grid ColumnDefinitions="110,*,Auto" Margin="0,4,0,0">
                    <TextBlock Classes="fieldLabel" Text="PID" />
                    <TextBox x:Name="PidBox" Grid.Column="1" MaxLength="8" TextChanged="OnPidChanged" />
                    <CheckBox
                        x:Name="ShinyCheck"
                        Grid.Column="2"
                        Content="Shiny"
                        Margin="10,0,0,0"
                        ToolTip.Tip="Rolls a PID/IV pair with the wanted shininess (both change together)" />
                </Grid>

                <Grid ColumnDefinitions="110,*,110,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="HP IV" />
                    <NumericUpDown x:Name="IvHp" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="31" Increment="1"
                                   ShowButtonSpinner="False" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="fieldLabel" Text="Attack IV" />
                    <NumericUpDown x:Name="IvAtk" Grid.Row="0" Grid.Column="3" Minimum="0" Maximum="31" Increment="1"
                                   ShowButtonSpinner="False" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Defense IV" />
                    <NumericUpDown x:Name="IvDef" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="31" Increment="1"
                                   ShowButtonSpinner="False" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="fieldLabel" Text="Sp. Atk IV" />
                    <NumericUpDown x:Name="IvSpa" Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="31" Increment="1"
                                   ShowButtonSpinner="False" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Sp. Def IV" />
                    <NumericUpDown x:Name="IvSpd" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="31" Increment="1"
                                   ShowButtonSpinner="False" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="fieldLabel" Text="Speed IV" />
                    <NumericUpDown x:Name="IvSpe" Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="31" Increment="1"
                                   ShowButtonSpinner="False" Margin="0,2" />
                </Grid>

                <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
                    <TextBlock Classes="fieldLabel" Text="Current HP" />
                    <NumericUpDown x:Name="HpBox" Grid.Column="1" Minimum="0" Maximum="65535" Increment="1"
                                   ShowButtonSpinner="False" />
                </Grid>

                <CheckBox x:Name="ActiveCheck" Content="Roamer is active" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource SpacingRegular}">
            <Button Content="Cancel" MinWidth="96" Click="OnCancelClicked" />
            <Button x:Name="SaveButton" Content="Save" MinWidth="96" Click="OnSaveClicked" />
        </StackPanel>

    </StackPanel>

</Window>
