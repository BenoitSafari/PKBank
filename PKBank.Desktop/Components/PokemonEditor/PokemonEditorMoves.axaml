<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components.PokemonEditor.ViewModels"
             x:Class="PKBank.Desktop.Components.PokemonEditor.PokemonEditorMoves"
             x:DataType="vm:PokemonEditorViewModel">

    <UserControl.Resources>
        <!-- Move entry: type icon + name + category (red when the current entity cannot learn it) + trailing "Illegal ✗" badge -->
        <DataTemplate x:Key="MoveChoiceTemplate" DataType="vm:MoveChoice">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Image Source="{Binding TypeSprite}" Width="20" Height="20" Margin="0,0,7,0"
                       VerticalAlignment="Center" IsVisible="{Binding HasType}" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center"
                           Classes.illegal="{Binding IsIllegal}" />
                <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" VerticalAlignment="Center" Margin="7,0,0,0"
                           Opacity="0.6" FontSize="{DynamicResource FontSizeRegular}" />
                <TextBlock Grid.Column="3" Text="Illegal ✗" Classes="illegal" FontWeight="SemiBold"
                           Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsIllegal}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <!-- Hover summary for a selected move -->
        <DataTemplate DataType="vm:MoveTipViewModel">
            <StackPanel Spacing="4" MinWidth="170">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Image Source="{Binding TypeSprite}" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Type" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TypeName}" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Category}" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Power" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Power}" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Accuracy" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Accuracy}" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="PP" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PP}" FontSize="{DynamicResource FontSizeRegular}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- Illegal move indication (same accent as the legality badge) -->
        <Style Selector="TextBlock.illegal">
            <Setter Property="Foreground" Value="IndianRed" />
        </Style>
        <!-- Fluent's ComboBox theme pins VerticalAlignment to Top, which leaves it shorter than the
             NumericUpDown next to it; stretching makes every field in a row the same height. Row
             spacing is handled by the containing StackPanel, not by a margin. -->
        <Style Selector="ComboBox.field">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="4" Margin="0,8,0,0">
        <TextBlock Text="Moves" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeLarge}" />
        <Grid ColumnDefinitions="*,104,40">
            <TextBlock Grid.Column="1" Text="PP Ups" HorizontalAlignment="Center" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" />
            <TextBlock Grid.Column="2" Text="PP" HorizontalAlignment="Center" Opacity="0.7" FontSize="{DynamicResource FontSizeRegular}" />
        </Grid>
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,104,40">
                <ComboBox Classes="field" ItemsSource="{Binding MoveList}"
                          ItemTemplate="{StaticResource MoveChoiceTemplate}"
                          DropDownOpened="OnMoveDropDownOpened"
                          SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move1, Mode=TwoWay}"
                          ToolTip.Tip="{Binding MoveTip1}" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1"
                               Value="{Binding PPUps1, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)" />
                <TextBlock Grid.Column="2" Text="{Binding PP1Display}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,104,40">
                <ComboBox Classes="field" ItemsSource="{Binding MoveList}"
                          ItemTemplate="{StaticResource MoveChoiceTemplate}"
                          DropDownOpened="OnMoveDropDownOpened"
                          SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move2, Mode=TwoWay}"
                          ToolTip.Tip="{Binding MoveTip2}" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1"
                               Value="{Binding PPUps2, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)" />
                <TextBlock Grid.Column="2" Text="{Binding PP2Display}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,104,40">
                <ComboBox Classes="field" ItemsSource="{Binding MoveList}"
                          ItemTemplate="{StaticResource MoveChoiceTemplate}"
                          DropDownOpened="OnMoveDropDownOpened"
                          SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move3, Mode=TwoWay}"
                          ToolTip.Tip="{Binding MoveTip3}" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1"
                               Value="{Binding PPUps3, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)" />
                <TextBlock Grid.Column="2" Text="{Binding PP3Display}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,104,40">
                <ComboBox Classes="field" ItemsSource="{Binding MoveList}"
                          ItemTemplate="{StaticResource MoveChoiceTemplate}"
                          DropDownOpened="OnMoveDropDownOpened"
                          SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move4, Mode=TwoWay}"
                          ToolTip.Tip="{Binding MoveTip4}" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1"
                               Value="{Binding PPUps4, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)" />
                <TextBlock Grid.Column="2" Text="{Binding PP4Display}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </StackPanel>

</UserControl>
