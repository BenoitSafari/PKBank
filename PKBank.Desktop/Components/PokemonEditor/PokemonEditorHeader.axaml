<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components.PokemonEditor.ViewModels"
             xmlns:u="using:PKBank.Desktop.Utils"
             x:Class="PKBank.Desktop.Components.PokemonEditor.PokemonEditorHeader"
             x:DataType="vm:PokemonEditorViewModel">

    <!-- Band above the tabs: sprite and nickname on the left, legality and actions on the right -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Image Grid.Column="0"
               Source="{Binding Sprite}"
               Width="68"
               Height="56"
               Stretch="None"
               VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Nickname}"
                   Margin="12,0,8,0"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSizeLarge}"
                   FontWeight="SemiBold" />
        <!-- An empty slot reports "Legal" by default; hide the badge rather than show a false pass -->
        <Button Grid.Column="2" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center"
                Click="OnLegalityClicked"
                IsVisible="{Binding HasSpecies}"
                ToolTip.Tip="Open the full legality report">
            <TextBlock Text="{Binding LegalitySummary}"
                       FontWeight="SemiBold"
                       Foreground="{Binding LegalityValid, Converter={x:Static u:Converters.LegalityBrush}}"/>
        </Button>
        <Button Grid.Column="3" VerticalAlignment="Center" MinWidth="42" Margin="0,0,8,0"
                Content="Fix"
                IsVisible="{Binding !LegalityValid}"
                Click="OnFixLegalityClicked"
                ToolTip.Tip="Rebuild a PID/IV pair the encounter could have produced"/>
        <Button Grid.Column="4" VerticalAlignment="Center" MinWidth="42"
                Content="QR"
                IsEnabled="{Binding HasSpecies}"
                Click="OnQrClicked"
                ToolTip.Tip="Show the QR code for this Pokémon"/>
    </Grid>

</UserControl>
