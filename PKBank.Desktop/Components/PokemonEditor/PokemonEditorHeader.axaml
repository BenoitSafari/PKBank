<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components.PokemonEditor.ViewModels"
             xmlns:u="using:PKBank.Desktop.Utils"
             x:Class="PKBank.Desktop.Components.PokemonEditor.PokemonEditorHeader"
             x:DataType="vm:PokemonEditorViewModel">

    <!-- Sprite + name/PID block, legality badge + QR at the top right -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                CornerRadius="6"
                Padding="6"
                VerticalAlignment="Top">
            <Image Source="{Binding Sprite}"
                   Width="68"
                   Height="56"
                   Stretch="None" />
        </Border>
        <StackPanel Grid.Column="1"
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    Spacing="{DynamicResource SpacingRegular}">
            <TextBlock Text="{Binding Nickname}"
                       FontSize="{DynamicResource FontSizeExtraLarge}"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingRegular}">
                <CheckBox Content="Shiny"
                          IsChecked="{Binding IsShiny, Mode=TwoWay}" />
                <CheckBox Content="Egg"
                          IsChecked="{Binding IsEgg, Mode=TwoWay}"
                          IsVisible="{Binding HasEgg}" />
                <Button Content="{Binding GenderSymbol}"
                        MinWidth="34"
                        IsEnabled="{Binding CanCycleGender}"
                        Command="{Binding CycleGender}"
                        ToolTip.Tip="Toggle gender (rerolls a valid PID)" />
            </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Top"
                Click="OnLegalityClicked"
                IsEnabled="{Binding HasSpecies}"
                ToolTip.Tip="Open the full legality report">
            <TextBlock Text="{Binding LegalitySummary}"
                       FontWeight="SemiBold"
                       Foreground="{Binding LegalityValid, Converter={x:Static u:Converters.LegalityBrush}}"/>
        </Button>
        <Button Grid.Column="3" VerticalAlignment="Top" MinWidth="42" Margin="0,0,8,0"
                Content="Fix"
                IsVisible="{Binding !LegalityValid}"
                Click="OnFixLegalityClicked"
                ToolTip.Tip="Rebuild a PID/IV pair the encounter could have produced"/>
        <Button Grid.Column="4" VerticalAlignment="Top" MinWidth="42"
                Content="QR"
                IsEnabled="{Binding HasSpecies}"
                Click="OnQrClicked"
                ToolTip.Tip="Show the QR code for this Pokémon"/>
    </Grid>

</UserControl>
