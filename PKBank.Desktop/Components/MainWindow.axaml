<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKBank.Desktop.Components"
        xmlns:v="using:PKBank.Desktop.Components"
        xmlns:ss="using:PKBank.Desktop.Components.SaveSelection"
        xmlns:bank="using:PKBank.Desktop.Components.Bank"
        x:Class="PKBank.Desktop.Components.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <DockPanel>
            <v:MainWindowMenu DockPanel.Dock="Top" />

            <v:MainWindowStatus DockPanel.Dock="Bottom" />

            <Grid Margin="10">

                <!-- No save loaded: the selection screen takes over the content area -->
                <ss:SaveSelectionView IsVisible="{Binding !HasSave}" />

                <!-- Storage: editing happens in PokemonEditorWindow, so the boxes get the full width -->
                <DockPanel IsVisible="{Binding HasSave}">

                    <!-- Selected-slot actions: mirrors the slot context menu -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource SpacingSmall}">
                        <!-- Fixed width so the bar does not shift as the label flips Edit/New -->
                        <Button Content="{Binding EditSelectedLabel}" MinWidth="64"
                                Click="OnEditSelectedClicked" IsEnabled="{Binding CanEditSelected}" />
                        <Button Content="Copy" Click="OnCopySelectedClicked" IsEnabled="{Binding CanCopySelected}" />
                        <Button Content="Paste" Click="OnPasteSelectedClicked"
                                IsEnabled="{Binding CanPasteSelected}" />
                        <Button Content="Import" Click="OnImportSelectedClicked"
                                IsEnabled="{Binding CanImportSelected}" />
                        <Button Content="Export" Click="OnExportSelectedClicked"
                                IsEnabled="{Binding CanExportSelected}" />
                        <Button Content="Delete" Click="OnDeleteClicked" IsEnabled="{Binding CanDeleteSelected}" />
                    </StackPanel>

                    <!-- Party, save boxes and bank stack up and scroll vertically; only the boxes scroll sideways -->
                    <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
                        <!-- Right margin keeps the full-width Boxes frame clear of the vertical scrollbar -->
                        <StackPanel Spacing="{DynamicResource SpacingLarge}" Margin="0,0,16,0">

                            <StackPanel IsVisible="{Binding HasParty}">
                                <TextBlock Classes="sectionTitle" Text="Party" />
                                <Border Classes="section">
                                    <ItemsControl x:Name="PartyItems" ItemsSource="{Binding PartySlots}" Margin="8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- Open box panels side by side across the full width, with their own scrollbar.
                                 The ScrollViewer's own bar would overlay the slots, so a separate one sits
                                 under them and only takes room when the boxes overflow. -->
                            <StackPanel IsVisible="{Binding HasBox}">
                                <TextBlock Classes="sectionTitle" Text="Boxes" />
                                <Border Classes="section" HorizontalAlignment="Stretch">
                                    <DockPanel>
                                        <ScrollBar x:Name="BoxesScrollBar" DockPanel.Dock="Bottom"
                                                   Orientation="Horizontal" AllowAutoHide="False"
                                                   Margin="8,0,8,8" IsVisible="False" />
                                        <ScrollViewer x:Name="BoxesScroller"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="BoxPanelsItems" Classes="boxPanels"
                                                          ItemsSource="{Binding OpenBoxes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="sectionTitle" Text="Bank" />
                                <Border Classes="section">
                                    <bank:BankSection x:Name="BankSection" />
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>

            </Grid>

        </DockPanel>

        <!-- Ghost sprite following the cursor during a slot drag -->
        <Canvas x:Name="DragGhostLayer" IsHitTestVisible="False" IsVisible="False">
            <Image x:Name="DragGhostImage" Width="68" Height="56" Stretch="None" Opacity="0.65" />
        </Canvas>
    </Panel>

</Window>
