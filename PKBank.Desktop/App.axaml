<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.Components.Box.ViewModels"
             xmlns:u="using:PKBank.Desktop.Utils"
             xmlns:box="using:PKBank.Desktop.Components.Box"
             x:Class="PKBank.Desktop.App"
             RequestedThemeVariant="Default">

    <!-- Implicit templates: storage view-models render the same way in every window. -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:SlotViewModel">
            <box:SlotView />
        </DataTemplate>
        <DataTemplate DataType="vm:BoxPanelViewModelBase">
            <box:BoxPanel />
        </DataTemplate>

        <!-- Rich hover preview shown as the slot tooltip -->
        <DataTemplate DataType="vm:SlotPreviewViewModel">
            <StackPanel Spacing="{DynamicResource SpacingExtraSmall}" MaxWidth="340">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingSmall}">
                    <Image Source="{Binding BallSprite}" Width="20" Height="20" Stretch="None"
                           IsVisible="{Binding BallSprite, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding LegalitySummary}" FontWeight="SemiBold"
                           Foreground="{Binding IsValid, Converter={x:Static u:Converters.LegalityBrush}}" />
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeRegular}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding LegalityLine}" FontSize="{DynamicResource FontSizeRegular}" TextWrapping="Wrap"
                           Foreground="IndianRed"
                           IsVisible="{Binding HasLegalityLine}" />
                <ItemsControl ItemsSource="{Binding DetailLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeRegular}" Opacity="0.85" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://PKBank.Desktop/Theme/AppTheme.axaml" />
        <StyleInclude Source="avares://PKBank.Desktop/Components/Box/BoxStyles.axaml" />
    </Application.Styles>

</Application>
