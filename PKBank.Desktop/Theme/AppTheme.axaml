                                     Color="{StaticResource ThemeAccentColor}" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource ThemeAccentColor}" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource ThemeBorderColor}"
                                     Opacity="0.5" />

                    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ThemeButtonColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource ThemeHoverColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource ThemePressedColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource ThemeButtonColor}"
                                     Opacity="0.5" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource ThemeButtonColor}" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ThemeForegroundColor}" />
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled"
                                     Color="{StaticResource ThemeForegroundDisabledColor}" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource ThemeForegroundColor}" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed"
                                     Color="{StaticResource ThemeForegroundColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ThemeBorderColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource ThemeAccentColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource ThemeAccentColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource ThemeBorderColor}"
                                     Opacity="0.5" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused"
                                     Color="{StaticResource ThemeAccentColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused"
                                     Color="{StaticResource ThemeBorderColor}" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource ThemeViewColor}" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource ThemeBorderColor}" />

                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush"
                                     Color="{StaticResource ThemeHoverColor}" />
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush"
                                     Color="{StaticResource ThemeHoverColor}" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush"
                                     Color="{StaticResource ThemeAccentColor}" Opacity="0.2" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush"
                                     Color="{StaticResource ThemeAccentColor}" Opacity="0.3" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush"
                                     Color="{StaticResource ThemeAccentColor}" Opacity="0.45" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush"
                                     Color="{StaticResource ThemeForegroundColor}" />
                    <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush"
                                     Color="{StaticResource ThemeForegroundDisabledColor}" />

                    <Color x:Key="ScrollBarThumbBackgroundColor">#B7BBBE</Color>
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource ThemeViewColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource ThemeAccentColor}"
                                     Opacity="0.6" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource ThemeAccentColor}"
                                     Opacity="0.8" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="{StaticResource ThemeBorderColor}" />

                    <!-- Tabs: the selected one shares the panel's background so the two merge -->
                    <SolidColorBrush x:Key="TabBorderBrush" Color="{StaticResource ThemeBorderColor}" />
                    <SolidColorBrush x:Key="TabPanelBackground" Color="{StaticResource ThemeWindowColor}" />
                    <SolidColorBrush x:Key="TabItemBackgroundUnselected" Color="{StaticResource ThemeViewColor}" />
                    <SolidColorBrush x:Key="TabItemBackgroundPointerOver" Color="{StaticResource ThemeHoverColor}" />
                    <SolidColorBrush x:Key="TabItemForeground" Color="{StaticResource ThemeForegroundColor}" />
                    <SolidColorBrush x:Key="TabItemForegroundUnselected"
                                     Color="{StaticResource ThemeForegroundMutedColor}" />

                    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource ThemeTooltipColor}" />
                    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource ThemeForegroundColor}" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource ThemeBorderColor}" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Padding" Value="{DynamicResource BaseInputPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeRegular}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="{DynamicResource BaseInputHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Each control type takes its height from a different Fluent resource (26 for TextBox, 25 for
         ComboBox, …), so a row of mixed inputs never lines up. They all go through BaseInputHeight. -->
    <Style Selector="TextBox">
        <Setter Property="Padding" Value="{DynamicResource BaseInputPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeRegular}" />
        <Setter Property="MinHeight" Value="{DynamicResource BaseInputHeight}" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Padding" Value="{DynamicResource BaseInputPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeRegular}" />
        <Setter Property="MinHeight" Value="{DynamicResource BaseInputHeight}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Padding" Value="{DynamicResource BaseInputPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeRegular}" />
        <Setter Property="MinHeight" Value="{DynamicResource BaseInputHeight}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="{DynamicResource BaseInputPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeRegular}" />
        <Setter Property="CornerRadius" Value="{DynamicResource BaseRadius}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>

</Styles>
