<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKBank.Desktop.ViewModels"
        x:Class="PKBank.Desktop.Views.Roamer.Roamer4EditorWindow"
        Title="Roamer Editor"
        Width="450" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto" Margin="14">

        <TabControl x:Name="RoamerTabs" Grid.Row="0">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="vm:RoamerTabViewModel">
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="vm:RoamerTabViewModel">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                        <StackPanel Spacing="6">

                            <Grid ColumnDefinitions="110,*,Auto">
                                <TextBlock Classes="fieldLabel" Text="PID"/>
                                <TextBox Grid.Column="1" MaxLength="8" Text="{Binding PidText, Mode=TwoWay}"/>
                                <CheckBox Grid.Column="2" Content="Shiny" IsEnabled="False" Margin="10,0,0,0"
                                          IsChecked="{Binding IsShiny, Mode=OneWay}"/>
                            </Grid>

                            <Grid ColumnDefinitions="110,*,110,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="HP IV"/>
                                <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="31" Increment="1" ShowButtonSpinner="False" Margin="0,2,10,2" Value="{Binding IvHp, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="fieldLabel" Text="Attack IV"/>
                                <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="0" Maximum="31" Increment="1" ShowButtonSpinner="False" Margin="0,2" Value="{Binding IvAtk, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Defense IV"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="31" Increment="1" ShowButtonSpinner="False" Margin="0,2,10,2" Value="{Binding IvDef, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="fieldLabel" Text="Sp. Atk IV"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="31" Increment="1" ShowButtonSpinner="False" Margin="0,2" Value="{Binding IvSpa, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Sp. Def IV"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="31" Increment="1" ShowButtonSpinner="False" Margin="0,2,10,2" Value="{Binding IvSpd, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Classes="fieldLabel" Text="Speed IV"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="31" Increment="1" ShowButtonSpinner="False" Margin="0,2" Value="{Binding IvSpe, Mode=TwoWay}"/>
                            </Grid>

                            <Grid ColumnDefinitions="110,*,110,*" Margin="0,4,0,0">
                                <TextBlock Classes="fieldLabel" Text="Level"/>
                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" ShowButtonSpinner="False" Margin="0,0,10,0" Value="{Binding Level, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Current HP"/>
                                <NumericUpDown Grid.Column="3" Minimum="0" Maximum="65535" Increment="1" ShowButtonSpinner="False" Value="{Binding HpCurrent, Mode=TwoWay}"/>
                            </Grid>

                            <Grid ColumnDefinitions="110,*,110,*">
                                <TextBlock Classes="fieldLabel" Text="Location"/>
                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="65535" Increment="1" ShowButtonSpinner="False" Margin="0,0,10,0" Value="{Binding Location, Mode=TwoWay}"
                                               ToolTip.Tip="Raw in-game map id the roamer currently is on"/>
                                <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Status (raw)"/>
                                <NumericUpDown Grid.Column="3" Minimum="0" Maximum="255" Increment="1" ShowButtonSpinner="False" Value="{Binding Status, Mode=TwoWay}"/>
                            </Grid>

                            <CheckBox Content="Roamer is active" Margin="0,4,0,0" IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="96" Click="OnCancelClicked"/>
            <Button Content="Save" MinWidth="96" Click="OnSaveClicked"/>
        </StackPanel>

    </Grid>

</Window>
