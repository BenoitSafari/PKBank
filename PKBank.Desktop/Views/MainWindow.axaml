<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKBank.Desktop.ViewModels"
        xmlns:v="using:PKBank.Desktop.Views"
        xmlns:pe="using:PKBank.Desktop.Views.Components.PokemonEditor"
        xmlns:ss="using:PKBank.Desktop.Views.Components.SaveSelection"
        x:Class="PKBank.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <DockPanel>
            <v:MainWindowMenu DockPanel.Dock="Top" />

            <v:MainWindowStatus DockPanel.Dock="Bottom" />

            <Grid ColumnDefinitions="478,*" Margin="10">

                <!-- No save loaded: the selection screen takes over the content area -->
                <ss:SaveSelectionView Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding !HasSave}" />

                <!-- Pokémon editor (left) -->
                <Border Grid.Column="0"
                        IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10">
                    <ContentControl Content="{Binding Editor}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:PokemonEditorViewModel">
                                <pe:PokemonEditorView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <!-- Storage (right) -->
                <Border Grid.Column="1" Margin="10,0,0,0"
                        IsVisible="{Binding HasSave}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10">
                    <DockPanel>

                        <!-- Selected-slot actions: mirrors the slot context menu (View/Set/Delete) -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6">
                            <Button Content="View" Click="OnViewSelectedClicked" IsEnabled="{Binding CanViewSelected}" />
                            <Button Content="Set" Click="OnSetSelectedClicked" IsEnabled="{Binding CanSetSelected}" />
                            <Button Content="Import" Click="OnImportSelectedClicked"
                                    IsEnabled="{Binding CanImportSelected}" />
                            <Button Content="Export" Click="OnExportSelectedClicked"
                                    IsEnabled="{Binding CanExportSelected}" />
                            <Button Content="Delete" Click="OnDeleteClicked" IsEnabled="{Binding CanDeleteSelected}" />
                            <Button Content="Bank" Classes="accent" Click="OnBankClicked"
                                    IsEnabled="{Binding CanOpenBank}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasParty}" Margin="0,10,0,0">
                            <TextBlock Text="Party" FontWeight="SemiBold" Margin="2,0,0,4" />
                            <ItemsControl x:Name="PartyItems" ItemsSource="{Binding PartySlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Open box panels: fixed-size boxes flowing left to right, wrapping to the next line -->
                        <ScrollViewer Margin="0,10,0,0" IsVisible="{Binding HasBox}">
                            <ItemsControl x:Name="BoxPanelsItems" ItemsSource="{Binding OpenBoxes}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                    </DockPanel>
                </Border>

            </Grid>

        </DockPanel>

        <!-- Ghost sprite following the cursor during a slot drag -->
        <Canvas x:Name="DragGhostLayer" IsHitTestVisible="False" IsVisible="False">
            <Image x:Name="DragGhostImage" Width="68" Height="56" Stretch="None" Opacity="0.65" />
        </Canvas>
    </Panel>

</Window>
