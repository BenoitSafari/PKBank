<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKBank.Desktop.ViewModels"
             xmlns:v="using:PKBank.Desktop.Views"
             xmlns:core="using:PKHeX.Core"
             x:Class="PKBank.Desktop.Views.PokemonEditorView"
             x:DataType="vm:PokemonEditorViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="ComboItemTemplate" DataType="core:ComboItem">
      <TextBlock Text="{Binding Text}"/>
    </DataTemplate>
    <!-- Move entry: type icon + name + category (red when the current entity cannot learn it) + trailing "Illegal ✗" badge -->
    <DataTemplate x:Key="MoveChoiceTemplate" DataType="vm:MoveChoice">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Image Source="{Binding TypeSprite}" Width="20" Height="20" Margin="0,0,7,0"
               VerticalAlignment="Center" IsVisible="{Binding HasType}"/>
        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" Classes.illegal="{Binding IsIllegal}"/>
        <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" VerticalAlignment="Center" Margin="7,0,0,0"
                   Opacity="0.6" FontSize="12"/>
        <TextBlock Grid.Column="3" Text="Illegal ✗" Classes="illegal" FontWeight="SemiBold"
                   Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsIllegal}"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <!-- Hover summary for a selected move -->
    <DataTemplate DataType="vm:MoveTipViewModel">
      <StackPanel Spacing="4" MinWidth="170">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Image Source="{Binding TypeSprite}" Width="20" Height="20" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="Type" Opacity="0.7" FontSize="12"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TypeName}" FontSize="12"/>
          <TextBlock Grid.Row="1" Text="Category" Opacity="0.7" FontSize="12"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Category}" FontSize="12"/>
          <TextBlock Grid.Row="2" Text="Power" Opacity="0.7" FontSize="12"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Power}" FontSize="12"/>
          <TextBlock Grid.Row="3" Text="Accuracy" Opacity="0.7" FontSize="12"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Accuracy}" FontSize="12"/>
          <TextBlock Grid.Row="4" Text="PP" Opacity="0.7" FontSize="12"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PP}" FontSize="12"/>
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <!-- Stat inputs: keep the bound background (e.g. maxed-EV red) on hover and
         focus, where the Fluent theme normally swaps in its own brushes. -->
    <Style Selector="TextBox.stat:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}"/>
    </Style>
    <Style Selector="TextBox.stat:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}"/>
    </Style>
    <!-- Graded EV total: black text over the colored grade background -->
    <Style Selector="TextBlock.graded">
      <Setter Property="Foreground" Value="Black"/>
    </Style>
    <!-- Illegal move indication (same accent as the legality badge) -->
    <Style Selector="TextBlock.illegal">
      <Setter Property="Foreground" Value="IndianRed"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="10" Margin="0,0,8,0">

      <!-- Header: sprite + summary + QR -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="6" Padding="6">
            <Image Source="{Binding Sprite}" Width="68" Height="56" Stretch="None"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="{Binding Nickname}" FontSize="18" FontWeight="SemiBold"/>
            <Button
                HorizontalAlignment="Left"
                Padding="8,4"
                Click="OnLegalityClicked"
                IsEnabled="{Binding HasSpecies}"
                ToolTip.Tip="Open the full legality report"
            >
              <TextBlock
                  Text="{Binding LegalitySummary}"
                  FontWeight="SemiBold"
                  Foreground="{Binding LegalityValid, Converter={x:Static v:Converters.LegalityBrush}}"
              />
            </Button>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" Content="QR" VerticalAlignment="Top" MinWidth="42"
                IsEnabled="{Binding HasSpecies}" Click="OnQrClicked"
                ToolTip.Tip="Show the QR code for this Pokémon"/>
      </Grid>

      <!-- Main fields -->
      <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Species"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Classes="field"
                  ItemsSource="{Binding SpeciesList}"
                  ItemTemplate="{StaticResource ComboItemTemplate}"
                  SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Species, Mode=TwoWay}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Form" IsVisible="{Binding HasForms}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Classes="field" IsVisible="{Binding HasForms}"
                  ItemsSource="{Binding FormList}"
                  SelectedIndex="{Binding Form, Mode=TwoWay}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Nickname"/>
        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding Nickname, Mode=TwoWay}" Margin="0,2"/>
          <CheckBox Grid.Column="1" Content="Nicknamed" Margin="8,0,0,0" IsChecked="{Binding IsNicknamed, Mode=TwoWay}"/>
        </Grid>

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldLabel" Text="Level"/>
        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="120,Auto,Auto,Auto">
          <NumericUpDown Grid.Column="0" Minimum="1" Maximum="100" Increment="1"
                         Value="{Binding Level, Mode=TwoWay}" Margin="0,2"/>
          <CheckBox Grid.Column="1" Content="Shiny" Margin="12,0,0,0" IsChecked="{Binding IsShiny, Mode=TwoWay}"/>
          <Button Grid.Column="2" Content="{Binding GenderSymbol}" Margin="12,0,0,0" MinWidth="42"
                  IsEnabled="{Binding CanCycleGender}" Command="{Binding CycleGender}"/>
        </Grid>

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldLabel" Text="Nature" IsVisible="{Binding HasNature}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Classes="field" IsVisible="{Binding HasNature}"
                  ItemsSource="{Binding NatureList}"
                  ItemTemplate="{StaticResource ComboItemTemplate}"
                  SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Nature, Mode=TwoWay}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="fieldLabel" Text="Ability" IsVisible="{Binding HasAbility}"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Classes="field" IsVisible="{Binding HasAbility}"
                  ItemsSource="{Binding AbilityList}"
                  ItemTemplate="{StaticResource ComboItemTemplate}"
                  SelectedIndex="{Binding AbilityIndex, Mode=TwoWay}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Classes="fieldLabel" Text="Held Item" IsVisible="{Binding HasItem}"/>
        <ComboBox Grid.Row="6" Grid.Column="1" Classes="field" IsVisible="{Binding HasItem}"
                  ItemsSource="{Binding ItemList}"
                  ItemTemplate="{StaticResource ComboItemTemplate}"
                  SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding HeldItem, Mode=TwoWay}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Classes="fieldLabel" Text="Ball" IsVisible="{Binding HasBall}"/>
        <ComboBox Grid.Row="7" Grid.Column="1" Classes="field" IsVisible="{Binding HasBall}"
                  ItemsSource="{Binding BallList}"
                  SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Ball, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="core:ComboItem">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Image Source="{Binding Value, Converter={x:Static v:Converters.BallSprite}}"
                       Width="20" Height="20" Stretch="None"/>
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="8" Grid.Column="0" Classes="fieldLabel" Text="Language" IsVisible="{Binding HasLanguage}"/>
        <ComboBox Grid.Row="8" Grid.Column="1" Classes="field" IsVisible="{Binding HasLanguage}"
                  ItemsSource="{Binding LanguageList}"
                  ItemTemplate="{StaticResource ComboItemTemplate}"
                  SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Language, Mode=TwoWay}"/>
      </Grid>

      <!-- Moves -->
      <TextBlock Text="Moves" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="*,104,40">
        <TextBlock Grid.Column="1" Text="PP Ups" HorizontalAlignment="Center" Opacity="0.7" FontSize="12"/>
        <TextBlock Grid.Column="2" Text="PP" HorizontalAlignment="Center" Opacity="0.7" FontSize="12"/>
      </Grid>
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="*,104,40">
          <ComboBox Classes="field" ItemsSource="{Binding MoveList}" ItemTemplate="{StaticResource MoveChoiceTemplate}"
                    DropDownOpened="OnMoveDropDownOpened"
                    SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move1, Mode=TwoWay}"
                    ToolTip.Tip="{Binding MoveTip1}"/>
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1" Margin="6,2,0,2"
                         Value="{Binding PPUps1, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)"/>
          <TextBlock Grid.Column="2" Text="{Binding PP1Display}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,104,40">
          <ComboBox Classes="field" ItemsSource="{Binding MoveList}" ItemTemplate="{StaticResource MoveChoiceTemplate}"
                    DropDownOpened="OnMoveDropDownOpened"
                    SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move2, Mode=TwoWay}"
                    ToolTip.Tip="{Binding MoveTip2}"/>
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1" Margin="6,2,0,2"
                         Value="{Binding PPUps2, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)"/>
          <TextBlock Grid.Column="2" Text="{Binding PP2Display}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,104,40">
          <ComboBox Classes="field" ItemsSource="{Binding MoveList}" ItemTemplate="{StaticResource MoveChoiceTemplate}"
                    DropDownOpened="OnMoveDropDownOpened"
                    SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move3, Mode=TwoWay}"
                    ToolTip.Tip="{Binding MoveTip3}"/>
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1" Margin="6,2,0,2"
                         Value="{Binding PPUps3, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)"/>
          <TextBlock Grid.Column="2" Text="{Binding PP3Display}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,104,40">
          <ComboBox Classes="field" ItemsSource="{Binding MoveList}" ItemTemplate="{StaticResource MoveChoiceTemplate}"
                    DropDownOpened="OnMoveDropDownOpened"
                    SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Move4, Mode=TwoWay}"
                    ToolTip.Tip="{Binding MoveTip4}"/>
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3" Increment="1" Margin="6,2,0,2"
                         Value="{Binding PPUps4, Mode=TwoWay}" ToolTip.Tip="PP Ups used (0-3)"/>
          <TextBlock Grid.Column="2" Text="{Binding PP4Display}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>

      <!-- Stats -->
      <TextBlock Text="Stats" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="64,52,72,72,46">
        <TextBlock Grid.Column="1" Text="Base" HorizontalAlignment="Center" Opacity="0.7" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="IV" HorizontalAlignment="Center" Opacity="0.7" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="EV" HorizontalAlignment="Center" Opacity="0.7" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="Stat" HorizontalAlignment="Center" Opacity="0.7" VerticalAlignment="Center"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding StatRows}" LostFocus="OnStatInputLostFocus">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:StatRowViewModel">
            <Grid ColumnDefinitions="64,52,72,72,46" Margin="0,1">
              <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="{Binding BaseBrush}" CornerRadius="3" Margin="2,0" MinHeight="30">
                <TextBlock Text="{Binding Base}" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBox Grid.Column="2" Classes="stat" Tag="iv" MaxLength="2" Margin="2,0" HorizontalContentAlignment="Center"
                       ToolTip.Tip="{Binding IVTip}" TextChanged="OnStatTextChanged"
                       Text="{Binding IVText, Mode=TwoWay}"/>
              <TextBox Grid.Column="3" Classes="stat" Tag="ev" MaxLength="3" Margin="2,0" HorizontalContentAlignment="Center"
                       ToolTip.Tip="{Binding EVTip}" TextChanged="OnStatTextChanged"
                       Background="{Binding EVBrush}"
                       Text="{Binding EVText, Mode=TwoWay}"/>
              <TextBlock Grid.Column="4" Text="{Binding Stat}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- Column totals (Format >= 3, as in WinForms) -->
      <Grid ColumnDefinitions="64,52,72,72,46" Margin="0,1" IsVisible="{Binding ShowTotalsRow}">
        <TextBlock Grid.Column="0" Text="Total" VerticalAlignment="Center" Opacity="0.85"/>
        <Border Grid.Column="1" Background="{Binding BSTBrush}" CornerRadius="3" Margin="2,0" MinHeight="30">
          <TextBlock Text="{Binding BST}" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding IVTotal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border Grid.Column="3" Background="{Binding EVTotalBrush}" CornerRadius="3" Margin="2,0" MinHeight="30"
                ToolTip.Tip="{Binding EVRemainingTip}">
          <TextBlock Text="{Binding EVTotal}" Classes.graded="{Binding EVTotalHasColor}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
      <!-- Random generation actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <Button x:Name="RandomIVsButton" Content="Randomize IVs" Click="OnRandomIVsClicked"
                ToolTip.Tip="Click: random (encounter-aware) · Ctrl: max · Alt: clear"/>
        <Button x:Name="RandomEVsButton" Content="Randomize EVs" Click="OnRandomEVsClicked"
                ToolTip.Tip="Click: random · Ctrl: max · Alt: clear"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
