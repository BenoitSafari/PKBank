<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKBank.Desktop.Views.Components.Events.Gen3EventFileWindow"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="14" Spacing="12">

        <Border
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="StatusText"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="HintText"
                    Opacity="0.7"
                    FontSize="12"
                    Text="Import a file, drop one onto this window, or export the current data."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="#C42B1C"
                    TextWrapping="Wrap"
                    IsVisible="False" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button
                Grid.Column="0"
                Content="Import…"
                MinWidth="96"
                Click="OnImportClicked" />
            <Button
                x:Name="ExportButton"
                Grid.Column="1"
                Content="Export…"
                MinWidth="96"
                Margin="8,0,0,0"
                Click="OnExportClicked" />
            <Button
                Grid.Column="3"
                Content="Close"
                MinWidth="96"
                Click="OnCloseClicked" />
        </Grid>

    </StackPanel>

</Window>
